# ---------- Core ----------
ENVIRONMENT=development
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB=agama_ai
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=10080
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---------- Ollama (cloud) ----------
# Ollama Cloud: https://ollama.com  (create a key at https://ollama.com/settings/keys)
OLLAMA_BASE_URL=https://ollama.com
OLLAMA_API_KEY=
# Any model available to your key, e.g. gpt-oss:120b, deepseek-v3.1:671b, qwen3-coder:480b
OLLAMA_MODEL=gpt-oss:120b
OLLAMA_TIMEOUT_SECONDS=120

# ---------- Code runner ----------
CODE_RUNNER_ENABLED=true
CODE_RUN_TIMEOUT_SECONDS=10
CODE_RUN_MEMORY_MB=512

# ---------- Demo ----------
DEMO_MODE=true

# ---------- AI help (free-tier guard) ----------
HELP_DAILY_LIMIT=40
